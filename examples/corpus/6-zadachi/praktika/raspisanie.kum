  кц

  лит запрос
  ввод запрос
  цел момент := минуты_от_полуночи(запрос)
  лог найдено := нет
  нц для i от 0 до 3
    если момент >= начала[i] и момент < концы[i] то
      вывод "В ", запрос, " идёт: ", предметы[i], " (до ", время_из_минут(концы[i]), ")"
      найдено := да
    все
  кц
  если не найдено то
    лог есть_дальше := нет
    цел j
    нц для j от 0 до 3
      если начала[j] > момент и не есть_дальше то
        вывод "Ближайшее занятие после ", запрос, ": ", предметы[j], " в ", время_из_минут(начала[j])
        есть_дальше := да
      все
    кц
    если не есть_дальше то
      вывод "На сегодня занятий больше нет"
    все
  все
