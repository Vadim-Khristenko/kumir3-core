| Калькулятор: разбор арифметического выражения рекурсивным спуском.
| ФАЙЛ: калькулятор выражений
| АВТОР: корпус Kumir 3
| УРОВЕНЬ: 6
| КАТЕГОРИЯ: tekst
| ТЕГИ: строки, разбор, рекурсия, приоритет операций

| Приоритет операций не задают таблицей — его задают формой разбора. Каждому
| уровню приоритета отвечает свой алгоритм, и он зовёт следующий, более
| «сильный»:
|
|   выражение  →  слагаемое { + | - слагаемое }
|   слагаемое  →  множитель { * | / множитель }
|   множитель  →  число | ( выражение ) | - множитель
|
| Умножение оказывается сильнее сложения просто потому, что `выражение`
| обращается к `слагаемому`, а не наоборот. Скобки же возвращают разбор на
| самый верх — оттого они и «сбрасывают» приоритет.
|
| Разбор идёт слева направо и никогда не возвращается: положение в строке
| хранится в глобальной `ПОЗ`, и каждый алгоритм двигает её вперёд ровно на
| то, что забрал себе. Такой разбор называют рекурсивным спуском.

лит ВЫР := ""
цел ПОЗ := 1

| Ноль вместо кода символа означает «строка кончилась». Так на конец строки
| не нужна отдельная проверка в каждом месте разбора.
алг цел код_текущего
нач
  если ПОЗ > длина(ВЫР) то
    знач := 0
  иначе
    знач := код(ВЫР[ПОЗ])
  все
кон

алг пропуск
нач
  нц пока код_текущего() = 32
    ПОЗ := ПОЗ + 1
  кц
кон

алг вещ число
нач
  пропуск()
  лит цифры := ""
  нц пока код_текущего() >= 48 и код_текущего() <= 57
    цифры := цифры + (ВЫР[ПОЗ] как лит)
    ПОЗ := ПОЗ + 1
  кц
  если цифры = "" то
    бросить "ожидалось число в позиции " + to_string(ПОЗ)
  все
  знач := to_float(цифры)
кон

алг вещ множитель
нач
  пропуск()
  цел к := код_текущего()
  если к = 45 то
    ПОЗ := ПОЗ + 1
    вернуть -множитель()
  все
  если к = 40 то
    ПОЗ := ПОЗ + 1
    вещ внутри := выражение()
    пропуск()
    если код_текущего() <> 41 то
      бросить "не хватает закрывающей скобки"
    все
    ПОЗ := ПОЗ + 1
    вернуть внутри
  все
  знач := число()
кон

алг вещ слагаемое
нач
  вещ значение := множитель()
  нц пока да
    пропуск()
    цел к := код_текущего()
    если к = 42 то
      ПОЗ := ПОЗ + 1
      значение := значение * множитель()
    иначе
      если к = 47 то
        ПОЗ := ПОЗ + 1
        вещ делитель := множитель()
        | Вещественные не сравнивают на равенство: проверяем близость к нулю.
        если abs(делитель) < 0.000000001 то
          бросить "деление на ноль"
        все
        значение := значение / делитель
      иначе
        прервать
      все
    все
  кц
  знач := значение
кон

алг вещ выражение
нач
  вещ значение := слагаемое()
  нц пока да
    пропуск()
    цел к := код_текущего()
    если к = 43 то
      ПОЗ := ПОЗ + 1
      значение := значение + слагаемое()
    иначе
      если к = 45 то
        ПОЗ := ПОЗ + 1
        значение := значение - слагаемое()
      иначе
        прервать
      все
    все
  кц
  знач := значение
кон

алг вещ вычислить(лит строка)
нач
  ВЫР := строка
  ПОЗ := 1
  вещ итог := выражение()
  пропуск()
  | Лишний хвост — тоже ошибка: «2+3)» разобралось бы молча до скобки.
  если ПОЗ <= длина(ВЫР) то
    бросить "лишний текст в позиции " + to_string(ПОЗ)
  все
  знач := итог
кон

| КЕЙС: приоритет операций и скобки
| ДОПУСК: вещ:1e-9
| ОЖИДАЕМЫЙ ВЫВОД:
| 2 + 3 * 4 = 14
| (2 + 3) * 4 = 20
| 10 - 2 - 3 = 5
| 100 / 4 / 5 = 5
| -3 + 10 = 7
алг главный
нач
  вывод "2 + 3 * 4 = ", вычислить("2 + 3 * 4")
  вывод "(2 + 3) * 4 = ", вычислить("(2 + 3) * 4")
  вывод "10 - 2 - 3 = ", вычислить("10 - 2 - 3")
  вывод "100 / 4 / 5 = ", вычислить("100 / 4 / 5")
  вывод "-3 + 10 = ", вычислить("-3 + 10")
кон

| КЕЙС: деление на ноль
| ОЖИДАЕМАЯ ОШИБКА: UserException / деление на ноль
алг главный
нач
  вывод вычислить("8 / (3 - 3)")
кон

| КЕЙС: неверная запись — пропущено второе слагаемое
| ОЖИДАЕМАЯ ОШИБКА: UserException / ожидалось число
алг главный
нач
  вывод вычислить("2 + ")
кон

| КЕЙС: незакрытая скобка
| ОЖИДАЕМАЯ ОШИБКА: UserException / закрывающей скобки
алг главный
нач
  вывод вычислить("(2 + 3")
кон
