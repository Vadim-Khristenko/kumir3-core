| Модель очереди к одной кассе по шагам времени: журнал по минутам и среднее ожидание.
| ФАЙЛ: очередь в магазине
| АВТОР: корпус Kumir 3
| УРОВЕНЬ: 6
| КАТЕГОРИЯ: modelirovanie
| ТЕГИ: моделирование, очередь, дискретное время

| Модель. Магазин с одной кассой. Время идёт целыми минутами, и на каждой минуте
| происходит ровно три вещи в строго определённом порядке:
|   1) в очередь встают все, кто пришёл к этой минуте;
|   2) если касса свободна, она берёт первого из очереди;
|   3) минута заканчивается, и если обслуживание истекло, касса освобождается.
| Порядок важен: если бы касса освобождалась раньше прихода, клиент, пришедший в ту
| же минуту, что и уход предыдущего, обслуживался бы «задним числом».
|
| Очередь — честная, «первым пришёл — первым обслужен». Удалять голову из таблицы
| дорого и незачем: вместо этого хранится индекс головы, а сама таблица только растёт.
| Длина очереди — это разность между её размером и индексом головы.
|
| Время ожидания клиента — минуты между его приходом и началом обслуживания;
| само обслуживание в ожидание не входит. Среднее ожидание — главный показатель
| модели: он показывает, справляется ли одна касса с потоком.
|
| Случайности нет: и минуты прихода, и длительности обслуживания заданы таблицами.

алг лит причина_отказа(таб цел приходы, таб цел длительности)
нач
  если длина(приходы) <> длина(длительности) то
    вернуть "таблицы прихода и обслуживания разной длины"
  все
  нц для i от 0 до длина(приходы) - 1
    если приходы[i] < 0 то
      вернуть "клиент не может прийти раньше нулевой минуты"
    все
    если длительности[i] <= 0 то
      вернуть "обслуживание клиента " + ((i + 1) как лит) + " не может длиться " + (длительности[i] как лит) + " мин"
    все
    если i > 0 и приходы[i] < приходы[i - 1] то
      вернуть "приходы должны идти по возрастанию времени"
    все
  кц
  знач := ""
кон

алг таб цел нули(цел н)
нач
  таб цел р
  нц для i от 1 до н
    р := добавить(р, 0)
  кц
  знач := р
кон

алг обслужить(таб цел приходы, таб цел длительности)
нач
  лит причина := причина_отказа(приходы, длительности)
  если причина <> "" то
    вывод "отказ: ", причина
    выход
  все
  цел всего := длина(приходы)
  если всего = 0 то
    вывод "клиентов нет: очередь не возникает, среднее ожидание не определено"
    выход
  все
  таб цел ожидание := нули(всего)
  таб цел очередь
  цел голова := 0
  цел следующий := 0
  цел уклиента := -1
  цел конец := 0
  цел обслужено := 0
  цел макс_очередь := 0
  цел мин := 0
  нц пока обслужено < всего
    лит пришли := ""
    нц пока следующий < всего и приходы[следующий] <= мин
      очередь := добавить(очередь, следующий)
      если пришли <> "" то
        пришли := пришли + ","
      все
      пришли := пришли + "к" + ((следующий + 1) как лит)
      следующий := следующий + 1
    кц
    если пришли = "" то
      пришли := "нет"
    все
    лит событие := ""
    если уклиента = -1 и голова < длина(очередь) то
      цел к := очередь[голова]
      голова := голова + 1
      уклиента := к
      конец := мин + длительности[к]
      ожидание[к] := мин - приходы[к]
      событие := "взяла к" + ((к + 1) как лит) + ", ждал " + (ожидание[к] как лит)
    иначе
      если уклиента = -1 то
        событие := "свободна"
      иначе
        событие := "занята к" + ((уклиента + 1) как лит)
      все
    все
    цел в_очереди := длина(очередь) - голова
    если в_очереди > макс_очередь то
      макс_очередь := в_очереди
    все
    вывод "минута ", мин, ": пришли ", пришли, "; касса ", событие, "; в очереди ", в_очереди
    | Освобождение кассы — последнее событие минуты, поэтому следующего клиента
    | она сможет взять только на следующем шаге времени.
    если уклиента <> -1 и мин = конец - 1 то
      обслужено := обслужено + 1
      уклиента := -1
    все
    мин := мин + 1
  кц
  цел сумма_ожиданий := 0
  нц для i от 0 до всего - 1
    сумма_ожиданий := сумма_ожиданий + ожидание[i]
    вывод "к", i + 1, ": пришёл в ", приходы[i], ", ждал ", ожидание[i], ", обслуживание ", длительности[i], " мин"
  кц
  вывод "магазин работал ", мин, " мин, обслужено клиентов: ", обслужено
  вывод "суммарное ожидание ", сумма_ожиданий, " мин, среднее ", round(сумма_ожиданий / всего, 2), " мин"
  вывод "наибольшая очередь ", макс_очередь, " чел."
кон

| КЕЙС: спокойный поток — касса успевает освободиться до следующего клиента
| Первые два клиента приходят на свободную кассу и ждут ноль минут. Третий приходит
| на шестой минуте, когда касса ещё занята вторым, и ждёт ровно одну минуту.
| ОЖИДАЕМЫЙ ВЫВОД:
| минута 0: пришли к1; касса взяла к1, ждал 0; в очереди 0
| минута 1: пришли нет; касса занята к1; в очереди 0
| минута 2: пришли нет; касса занята к1; в очереди 0
| минута 3: пришли нет; касса свободна; в очереди 0
| минута 4: пришли нет; касса свободна; в очереди 0
| минута 5: пришли к2; касса взяла к2, ждал 0; в очереди 0
| минута 6: пришли к3; касса занята к2; в очереди 1
| минута 7: пришли нет; касса взяла к3, ждал 1; в очереди 0
| минута 8: пришли нет; касса занята к3; в очереди 0
| минута 9: пришли нет; касса занята к3; в очереди 0
| минута 10: пришли нет; касса занята к3; в очереди 0
| к1: пришёл в 0, ждал 0, обслуживание 3 мин
| к2: пришёл в 5, ждал 0, обслуживание 2 мин
| к3: пришёл в 6, ждал 1, обслуживание 4 мин
| магазин работал 11 мин, обслужено клиентов: 3
| суммарное ожидание 1 мин, среднее 0.33 мин
| наибольшая очередь 1 чел.
алг главный
нач
  обслужить([0, 5, 6], [3, 2, 4])
кон

| КЕЙС: наплыв — четверо приходят одновременно, ожидание накапливается
| Все четверо встают в очередь на нулевой минуте, поэтому ожидание каждого равно
| сумме обслуживаний всех, кто стоит перед ним: 0, 2, 2+1, 2+1+3. Это и видно
| в журнале, и в таблице итогов; среднее 11/4 = 2.75 минуты.
| ОЖИДАЕМЫЙ ВЫВОД:
| минута 0: пришли к1,к2,к3,к4; касса взяла к1, ждал 0; в очереди 3
| минута 1: пришли нет; касса занята к1; в очереди 3
| минута 2: пришли нет; касса взяла к2, ждал 2; в очереди 2
| минута 3: пришли нет; касса взяла к3, ждал 3; в очереди 1
| минута 4: пришли нет; касса занята к3; в очереди 1
| минута 5: пришли нет; касса занята к3; в очереди 1
| минута 6: пришли нет; касса взяла к4, ждал 6; в очереди 0
| к1: пришёл в 0, ждал 0, обслуживание 2 мин
| к2: пришёл в 0, ждал 2, обслуживание 1 мин
| к3: пришёл в 0, ждал 3, обслуживание 3 мин
| к4: пришёл в 0, ждал 6, обслуживание 1 мин
| магазин работал 7 мин, обслужено клиентов: 4
| суммарное ожидание 11 мин, среднее 2.75 мин
| наибольшая очередь 3 чел.
алг главный
нач
  обслужить([0, 0, 0, 0], [2, 1, 3, 1])
кон

| КЕЙС: вырожденный случай — покупателей нет, среднее ожидание не определено
| Делить сумму ожиданий на ноль клиентов нельзя, поэтому пустой вход отсекается
| до начала счёта времени, а не превращается в деление на ноль.
| ОЖИДАЕМЫЙ ВЫВОД:
| клиентов нет: очередь не возникает, среднее ожидание не определено
алг главный
нач
  таб цел приходы
  таб цел длительности
  обслужить(приходы, длительности)
кон

| КЕЙС: проверка входных данных — четыре разных негодных набора
| Модель отвергает данные до начала счёта: нулевое обслуживание зациклило бы кассу,
| приходы вразнобой сломали бы порядок очереди, а таблицы разной длины означают
| потерянного клиента.
| ОЖИДАЕМЫЙ ВЫВОД:
| отказ: обслуживание клиента 2 не может длиться 0 мин
| отказ: приходы должны идти по возрастанию времени
| отказ: таблицы прихода и обслуживания разной длины
| отказ: клиент не может прийти раньше нулевой минуты
алг главный
нач
  обслужить([0, 3], [2, 0])
  обслужить([0, 3, 1], [2, 2, 2])
  обслужить([0, 3], [2])
  обслужить([-1], [2])
кон
