| Проверка скобочной последовательности: стек на таблице, три вида скобок.
| ФАЙЛ: проверка скобок
| АВТОР: корпус Kumir 3
| УРОВЕНЬ: 5
| КАТЕГОРИЯ: stroki-algoritmy
| ТЕГИ: строки, стек, таблицы, разбор, вложенность

| Задача разбора скобок — самая короткая задача, где без стека не обойтись.
| Одним счётчиком открытых скобок можно проверить только один вид скобок:
| счётчик знает, сколько скобок открыто, но не помнит, каких именно и в
| каком порядке. Строка "([)]" даёт нулевой баланс по обоим видам, а
| вложенность в ней перепутана. Значит, нужно помнить порядок открытых
| скобок — а это и есть стек.
|
| Правило разбора укладывается в три строки:
|   открывающая  — положить на стек;
|   закрывающая  — стек пуст? значит закрывать нечего, ошибка;
|                  иначе снять верхнюю и проверить, что она парная;
|   конец строки — стек обязан быть пуст, иначе что-то осталось незакрытым.
|
| Все три вида отказа попадают в кейсы ниже, потому что программа, которая
| ловит только «лишнюю закрывающую», ошибочна ровно наполовину.

| Стек здесь — обычная таблица плюс счётчик `вершина`: сколько мест занято.
| Такой стек не умеет расти сам — присваивание за границу таблицы в Kumir 3
| даёт ошибку «Индекс вне границ», а не расширение. Поэтому таблицу заранее
| набивают заглушками на всю возможную глубину: глубже, чем длина строки,
| стек не станет никогда, даже если строка состоит из одних открывающих.
алг таб сим пустой_стек(цел вместимость)
нач
  таб сим с
  с := []
  нц для i от 1 до вместимость
    с := с + [' ']
  кц
  знач := с
кон

| Пара скобок задана не списком условий, а двумя строками одинаковой длины:
| открывающая и закрывающая с одним и тем же номером — парные. Добавить
| четвёртый вид скобок здесь стоит два символа, а не новую ветку `если`.
алг лит открывающие_скобки
нач
  знач := "([{"
кон

алг лит закрывающие_скобки
нач
  знач := ")]}"
кон

| Возвращаем не «да/нет», а текст: при отказе полезен номер позиции, иначе
| человек не найдёт место ошибки в длинной строке. Позиции — от единицы,
| как и индексы строк в Kumir 3.
алг лит разбор_скобок(лит текст)
нач
  лит откр := открывающие_скобки()
  лит закр := закрывающие_скобки()
  таб сим стек := пустой_стек(длина(текст))
  цел вершина := 0
  нц для i от 1 до длина(текст)
    сим ч := текст[i]
    лит чл := ч как лит
    | `позиция` возвращает 1-based номер или 0, если символа нет. Ноль
    | здесь означает «обычный символ текста» — его разбор просто пропускает.
    цел о := позиция(откр, чл)
    цел з := позиция(закр, чл)
    если о > 0 то
      стек[вершина] := ч
      вершина := вершина + 1
    все
    если з > 0 то
      если вершина = 0 то
        вернуть "позиция " + to_string(i) + ": лишняя закрывающая " + чл
      все
      вершина := вершина - 1
      сим верх := стек[вершина]
      | Номер закрывающей в своей строке равен номеру её пары в строке
      | открывающих — отсюда и берётся ожидаемая скобка.
      сим нужна := откр[з]
      если верх <> нужна то
        вернуть "позиция " + to_string(i) + ": закрыли " + чл + ", а открыта была " + (верх как лит)
      все
    все
  кц
  | Пустой стек в конце — это не мелочь, а половина проверки: строка "(("
  | не нарушает ни одного правила по ходу разбора и отсеивается только здесь.
  если вершина > 0 то
    вернуть "не закрыта " + (стек[вершина - 1] как лит) + ", открытых осталось " + to_string(вершина)
  все
  знач := "сбалансировано"
кон

| Наибольшая высота стека за весь разбор — это глубина вложенности.
| Величина полезная: по ней видно, сколько памяти потребует рекурсивный
| разбор того же выражения.
алг цел глубина_вложенности(лит текст)
нач
  лит откр := открывающие_скобки()
  лит закр := закрывающие_скобки()
  цел вершина := 0
  цел макс := 0
  нц для i от 1 до длина(текст)
    лит чл := текст[i] как лит
    если позиция(откр, чл) > 0 то
      вершина := вершина + 1
      если вершина > макс то
        макс := вершина
      все
    все
    если позиция(закр, чл) > 0 то
      вершина := вершина - 1
    все
  кц
  знач := макс
кон

| КЕЙС: правильные последовательности всех трёх видов
| ОЖИДАЕМЫЙ ВЫВОД:
| () -> сбалансировано, глубина 1
| ([{}]) -> сбалансировано, глубина 3
| (){}[] -> сбалансировано, глубина 1
| а(б[в]г)д -> сбалансировано, глубина 2
| ((1+2)*(3-4)) -> сбалансировано, глубина 2
алг главный
нач
  таб лит примеры := ["()", "([{}])", "(){}[]", "а(б[в]г)д", "((1+2)*(3-4))"]
  нц для i от 0 до длина(примеры) - 1
    | Символы вне скобок разбор не трогает: буквы, цифры и знаки операций
    | проходят мимо обеих проверок и не влияют на стек.
    вывод примеры[i], " -> ", разбор_скобок(примеры[i]), ", глубина ", глубина_вложенности(примеры[i])
  кц
кон

| КЕЙС: неверная вложенность — балансы сходятся, порядок нарушен
| ОЖИДАЕМЫЙ ВЫВОД:
| ([)] -> позиция 3: закрыли ), а открыта была [
| {[}] -> позиция 3: закрыли }, а открыта была [
| ([{)}] -> позиция 4: закрыли ), а открыта была {
| счётчик круглых: открыто 1, закрыто 1
| счётчик квадратных: открыто 1, закрыто 1
алг главный
нач
  вывод "([)] -> ", разбор_скобок("([)]")
  вывод "{[}] -> ", разбор_скобок("{[}]")
  вывод "([{)}] -> ", разбор_скобок("([{)}]")
  | Ради наглядности пересчитаем "([)]" двумя счётчиками — так, как сделал бы
  | тот, кто решил обойтись без стека. Оба счётчика сходятся в ноль, и по ним
  | строка выглядит правильной. Именно эту ошибку стек и ловит: он помнит не
  | количество, а порядок.
  лит плохая := "([)]"
  цел кругл_о := 0
  цел кругл_з := 0
  цел квадр_о := 0
  цел квадр_з := 0
  нц для i от 1 до длина(плохая)
    если плохая[i] = '(' то
      кругл_о := кругл_о + 1
    все
    если плохая[i] = ')' то
      кругл_з := кругл_з + 1
    все
    если плохая[i] = '[' то
      квадр_о := квадр_о + 1
    все
    если плохая[i] = ']' то
      квадр_з := квадр_з + 1
    все
  кц
  вывод "счётчик круглых: открыто ", кругл_о, ", закрыто ", кругл_з
  вывод "счётчик квадратных: открыто ", квадр_о, ", закрыто ", квадр_з
кон

| КЕЙС: лишняя закрывающая — стек пуст, а закрывать просят
| ОЖИДАЕМЫЙ ВЫВОД:
| ()) -> позиция 3: лишняя закрывающая )
| )( -> позиция 1: лишняя закрывающая )
| ] -> позиция 1: лишняя закрывающая ]
| а)б -> позиция 2: лишняя закрывающая )
алг главный
нач
  | Отказ наступает на самой закрывающей скобке, а не в конце строки:
  | разбор не обязан дочитывать текст, чтобы понять, что он испорчен.
  вывод "()) -> ", разбор_скобок("())")
  вывод ")( -> ", разбор_скобок(")(")
  вывод "] -> ", разбор_скобок("]")
  вывод "а)б -> ", разбор_скобок("а)б")
кон

| КЕЙС: незакрытые скобки — ошибка видна только в конце
| ОЖИДАЕМЫЙ ВЫВОД:
| ([ -> не закрыта [, открытых осталось 2
| ( -> не закрыта (, открытых осталось 1
| ((( -> не закрыта (, открытых осталось 3
| (а + б -> не закрыта (, открытых осталось 1
алг главный
нач
  | По ходу разбора эти строки безупречны: ни одного нарушения правил.
  | Поэтому проверка «стек пуст в конце» — не украшение, а вторая половина
  | алгоритма. Сообщение называет последнюю незакрытую скобку: она лежит
  | на вершине и будет закрыта первой, если строку продолжить.
  вывод "([ -> ", разбор_скобок("([")
  вывод "( -> ", разбор_скобок("(")
  вывод "((( -> ", разбор_скобок("(((")
  вывод "(а + б -> ", разбор_скобок("(а + б")
кон

| КЕЙС: вырожденные входы — пустая строка, один символ, текст без скобок
| ОЖИДАЕМЫЙ ВЫВОД:
| пустая строка -> сбалансировано, глубина 0
| один символ а -> сбалансировано, глубина 0
| текст без скобок -> сбалансировано, глубина 0
| знаки препинания -> сбалансировано, глубина 0
| глубокая вложенность 10 -> сбалансировано, глубина 10
алг главный
нач
  | Пустая строка сбалансирована: ни одного правила нарушить не удалось.
  | Это не поблажка, а следствие определения — и заодно проверка того, что
  | цикл `нц для i от 1 до 0` не делает ни одного шага.
  вывод "пустая строка -> ", разбор_скобок(""), ", глубина ", глубина_вложенности("")
  вывод "один символ а -> ", разбор_скобок("а"), ", глубина ", глубина_вложенности("а")
  вывод "текст без скобок -> ", разбор_скобок("мама мыла раму"), ", глубина ", глубина_вложенности("мама мыла раму")
  вывод "знаки препинания -> ", разбор_скобок("да, точно: так!"), ", глубина ", глубина_вложенности("да, точно: так!")
  | Десять вложенных скобок: стек занимает ровно десять мест из десяти
  | выделенных, то есть заглушек хватило впритык — как и обещал расчёт.
  лит глубокая := "((((((((((" + "))))))))))"
  вывод "глубокая вложенность 10 -> ", разбор_скобок(глубокая), ", глубина ", глубина_вложенности(глубокая)
кон
